  # Single multi-subnet ASG — AWS distributes nodes across AZs for HA
  DynamicNodesASG:
    Type: 'AWS::AutoScaling::AutoScalingGroup'
    Condition: IsDynamicEnabled
    # SNS must be allowed to invoke the Lambda before the first lifecycle event fires.
    DependsOn:
      - DynamicNodesLaunchTemplate
      - TokenIssuerSNSPermission
    # One node at a time so the others keep serving; each old node drains and leaves via the terminate hook.
    UpdatePolicy:
      AutoScalingRollingUpdate:
        MinInstancesInService: 0
        MaxBatchSize: 1
        PauseTime: PT1M
    Properties:
      # Single-zone parents export PrivateSubnet2/3 equal to PrivateSubnet1, and Auto Scaling rejects duplicate subnet IDs.
      VPCZoneIdentifier: !If
        - ParentIsMultiZone
        - - Fn::ImportValue: !Sub ${ParentStackName}-PrivateSubnet1
          - Fn::ImportValue: !Sub ${ParentStackName}-PrivateSubnet2
          - Fn::ImportValue: !Sub ${ParentStackName}-PrivateSubnet3
        - - Fn::ImportValue: !Sub ${ParentStackName}-PrivateSubnet1
      LaunchTemplate:
        LaunchTemplateId: !Ref DynamicNodesLaunchTemplate
        Version: !GetAtt DynamicNodesLaunchTemplate.LatestVersionNumber
      MinSize: '0'
      MaxSize: !Ref DynamicNodesCount
      DesiredCapacity: !Ref DynamicNodesCount
      # Dynamic nodes use dedicated parent-ALB target groups on ports 9000-9008.
      TargetGroupARNs: !If
        - CreateDynamicAlbResources
        - - !Ref DynamicAlbTargetGroup9000
          - !Ref DynamicAlbTargetGroup9001
          - !Ref DynamicAlbTargetGroup9002
          - !Ref DynamicAlbTargetGroup9003
          - !Ref DynamicAlbTargetGroup9004
          - !Ref DynamicAlbTargetGroup9005
          - !Ref DynamicAlbTargetGroup9006
          - !Ref DynamicAlbTargetGroup9007
          - !Ref DynamicAlbTargetGroup9008
        - !Ref 'AWS::NoValue'
      Cooldown: '300'
      HealthCheckType: EC2
      HealthCheckGracePeriod: '300'
      LifecycleHookSpecificationList:
        - LifecycleHookName: DynamicNodeLaunchHook
          LifecycleTransition: autoscaling:EC2_INSTANCE_LAUNCHING
          # 20-min heartbeat — outlasts the Lambda's 15-min timeout so it always reports CONTINUE/ABANDON itself
          HeartbeatTimeout: 1200
          DefaultResult: ABANDON
          NotificationTargetARN: !Ref DynamicNodeLifecycleTopic
          RoleARN: !GetAtt DynamicNodesASGLifecycleRole.Arn
        - LifecycleHookName: DynamicNodeTerminateHook
          LifecycleTransition: autoscaling:EC2_INSTANCE_TERMINATING
          # 5-min heartbeat — Lambda removes the host from ML before the instance terminates
          HeartbeatTimeout: 300
          DefaultResult: CONTINUE
          NotificationTargetARN: !Ref DynamicNodeLifecycleTopic
          RoleARN: !GetAtt DynamicNodesASGLifecycleRole.Arn
      Tags:
        - Key: marklogic:stack:name
          Value: !Ref 'AWS::StackName'
          PropagateAtLaunch: 'true'
        - Key: marklogic:stack:id
          Value: !Ref 'AWS::StackId'
          PropagateAtLaunch: 'true'
        - Key: marklogic:dynamic-host-group
          Value: !Ref DynamicHostGroupName
          PropagateAtLaunch: 'true'

  # Updates after the ASG, so a renamed group is deleted only after its nodes were replaced.
  GroupCleanupResource:
    Type: Custom::GroupManager
    Condition: IsDynamicEnabled
    DependsOn: DynamicNodesASG
    Properties:
      ServiceToken: !GetAtt GroupManagerFunction.Arn
      # Above the Lambda's 360 s timeout, far below CloudFormation's 1 h default.
      ServiceTimeout: 420
      CleanupOnly: 'true'
      AdminUser: !Ref AdminUser
      AdminPass: !Ref AdminPass
      DynamicHostGroupName: !Ref DynamicHostGroupName

  # IAM Role allowing the ASG to publish lifecycle notifications to SNS
  DynamicNodesASGLifecycleRole:
    Type: AWS::IAM::Role
    Condition: IsDynamicEnabled
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: autoscaling.amazonaws.com
            Action: sts:AssumeRole
      Policies:
        - PolicyName: AllowSNSPublish
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action: sns:Publish
                Resource: !Ref DynamicNodeLifecycleTopic

Outputs:
  LambdaFunctionArn:
    Condition: IsDynamicEnabled
    Value: !GetAtt GroupManagerFunction.Arn

  DynamicNodesASGName:
    Condition: IsDynamicEnabled
    Description: Name of the Auto Scaling Group managing dynamic MarkLogic nodes
    Value: !Ref DynamicNodesASG

  TokenIssuerFunctionArn:
    Condition: IsDynamicEnabled
    Description: ARN of the Lambda that generates fresh tokens and joins each dynamic node at launch
    Value: !GetAtt TokenIssuerFunction.Arn
